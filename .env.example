# Auth.js / NextAuth (required for production; use placeholders for local build)
AUTH_SECRET=placeholder-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Microsoft Entra (Azure AD) — use real values from app registration when ready
AZURE_AD_CLIENT_ID=placeholder
AZURE_AD_TENANT_ID=placeholder
AZURE_AD_CLIENT_SECRET=placeholder

# Knowledge layer (default: supabase)
KNOWLEDGE_PROVIDER=supabase

# Supabase (when KNOWLEDGE_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: service role for server-only operations
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL (Prisma) — required for sessions, agents, knowledge base tables
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# OpenAI embeddings (knowledge search / RAG)
OPENAI_API_KEY=
# Optional: defaults to text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (coaching + assessment summary)
ANTHROPIC_API_KEY=

# Assessment Coach agent UUID (matches Prompt Control / agents table)
ASSESSMENT_COACH_ID=

# ElevenLabs voice (Assessment agent only in this repo)
ELEVENLABS_API_KEY=
ELEVENLABS_ASSESSMENT_AGENT_ID=

# Custom LLM endpoint (ElevenLabs calls this with Bearer token; not user session)
INTERVIEW_COACH_CUSTOM_LLM_API_KEY=

# Admin (SEI-52): comma-separated list of operator emails. Use lowercase in the value; comparison at runtime is case-insensitive.
# If unset or empty, any signed-in user can access /admin and /api/admin/* (permissive default for internal pilot).
# When set, only these emails may use admin after auth.
ADMIN_EMAILS=cminer@sei.com,amanueco@sei.com
