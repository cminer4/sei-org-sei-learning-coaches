# =============================================================================
# SEI Assessment Coach — environment template
# Copy to .env.local and fill in. Never commit real secrets.
# Production vs local: variables marked [prod] should be real in deployment.
# NODE_ENV is set by Next.js; do not set it here unless you know you need to.
# =============================================================================

# --- Auth.js / NextAuth [prod: AUTH_SECRET + AUTH_URL required] ---
AUTH_SECRET=placeholder-generate-with-openssl-rand-base64-32
# Canonical public origin for this app (Auth.js v5). Older NextAuth docs sometimes call this NEXTAUTH_URL; this repo uses AUTH_URL only.
# Local dev:
AUTH_URL=http://localhost:3000
# Production (Azure App Service example — use your real hostname):
# AUTH_URL=https://sei-learning-coaches.azurewebsites.net
# After deploy: add the same origin as a valid redirect URI in the Entra (Azure AD) app registration (action item for Antonio in the PR).

# --- Microsoft Entra (Azure AD) [prod: real app registration] ---
AZURE_AD_CLIENT_ID=placeholder
AZURE_AD_TENANT_ID=placeholder
AZURE_AD_CLIENT_SECRET=placeholder

# --- Knowledge layer ---
# supabase (default, works today) | azure (stub until AzureKnowledgeProvider is implemented)
KNOWLEDGE_PROVIDER=supabase

# --- Supabase [required when KNOWLEDGE_PROVIDER=supabase] ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: agents table, admin paths, logSystemEvent (preferred over anon for server writes)
SUPABASE_SERVICE_ROLE_KEY=

# --- PostgreSQL / Prisma [prod: required for sessions, agents, KB] ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- OpenAI embeddings (RAG / KB publish) [prod: required for embeddings] ---
OPENAI_API_KEY=
# Optional: defaults to text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic [prod: required for assessment summary + coaching] ---
ANTHROPIC_API_KEY=

# --- Assessment agent (Prompt Control UUID) [prod: required for coach flows] ---
ASSESSMENT_COACH_ID=

# --- ElevenLabs voice [prod: required for voice session] ---
ELEVENLABS_API_KEY=
ELEVENLABS_ASSESSMENT_AGENT_ID=

# --- ElevenLabs Custom LLM (Bearer; not user session) [prod: required for voice LLM proxy] ---
# ElevenLabs dashboard: set endpoint to https://<your-deployment-host>/api/voice-llm/chat/completions
INTERVIEW_COACH_CUSTOM_LLM_API_KEY=

# --- Admin (SEI-52) [optional: empty = any signed-in user can use /admin] ---
# Comma-separated lowercase emails; runtime match is case-insensitive.
ADMIN_EMAILS=cminer@sei.com,amanueco@sei.com
